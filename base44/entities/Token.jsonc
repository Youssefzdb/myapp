{
  "name": "Token",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "github",
        "google",
        "microsoft",
        "facebook",
        "apple",
        "custom"
      ],
      "description": "\u0645\u0632\u0648\u0651\u062f \u0627\u0644\u062a\u0648\u0643\u0646"
    },
    "owner_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0635\u0627\u062d\u0628 \u0627\u0644\u0631\u0628\u0637\u060c \u064a\u062d\u062f\u062f\u0647 \u0627\u0644\u062e\u0627\u062f\u0645 \u0645\u0646 \u062c\u0644\u0633\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "access_token": {
      "type": "string",
      "description": "\u062a\u0648\u0643\u0646 \u0627\u0644\u0648\u0635\u0648\u0644\u060c \u064a\u064f\u062d\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u062e\u0627\u062f\u0645 \u0648\u0644\u0627 \u064a\u064f\u0631\u0633\u0644 \u0625\u0644\u0649 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "refresh_token": {
      "type": "string",
      "description": "\u062a\u0648\u0643\u0646 \u0627\u0644\u062a\u062c\u062f\u064a\u062f (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "token_type": {
      "type": "string",
      "default": "Bearer"
    },
    "scope": {
      "type": "string",
      "description": "\u0646\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0645\u0646\u0648\u062d\u0629"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062a\u0648\u0643\u0646"
    },
    "external_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u062f\u0649 \u0627\u0644\u0645\u0632\u0648\u0651\u062f"
    },
    "label": {
      "type": "string",
      "description": "\u062a\u0633\u0645\u064a\u0629 \u062a\u0648\u0636\u064a\u062d\u064a\u0629 \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629"
    }
  },
  "required": [
    "provider",
    "access_token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}